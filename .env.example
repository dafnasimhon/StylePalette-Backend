# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS: comma-separated origins (Android emulator often uses http://10.0.2.2:8000 for local API)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# When true (default), missing models/face_landmarker.task is downloaded from Google on first analysis.
# MEDIAPIPE_ALLOW_MODEL_DOWNLOAD=true
# Optional: absolute path to a local .task file
# MEDIAPIPE_FACE_LANDMARKER_MODEL=C:\path\to\face_landmarker.task
# Optional: override download URL
# MEDIAPIPE_FACE_LANDMARKER_URL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task
