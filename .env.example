# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS: comma-separated origins (Android emulator often uses http://10.0.2.2:8000 for local API)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: when the CV engine is wired in, point to your partner module or enable a mock
USE_MOCK_ANALYSIS=true
