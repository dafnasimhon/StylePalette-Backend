# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS: comma-separated origins (Android emulator often uses http://10.0.2.2:8000 for local API)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# When false, the face landmarker .task is not auto-downloaded (require local or MEDIAPIPE_FACE_LANDMARKER_MODEL)
# MEDIAPIPE_ALLOW_MODEL_DOWNLOAD=true
